# Программа "Водный баланс"
# Помогает следить за количеством выпитой воды за день

print("=" * 40)
print("   💧 ДНЕВНИК ВОДЫ 💧")
print("=" * 40)

# Норма воды на день (в миллилитрах)
norma = 2000
vypito = 0

# Спрашиваем имя пользователя
name = input("Как тебя зовут? ")

print(f"\nПривет, {name}!")
print(f"Твоя норма на сегодня: {norma} мл воды.\n")

# Основной цикл — пока не выпьет норму
while vypito < norma:
    ostalos = norma - vypito
    print(f"Выпито: {vypito} мл | Осталось: {ostalos} мл")

    # Спрашиваем сколько выпил
    try:
        porciya = int(input("Сколько мл воды выпил? (0 — выйти): "))
    except ValueError:
        print("⚠️ Введи число, пожалуйста!\n")
        continue

    # Выход из программы
    if porciya == 0:
        print(f"\nТы выпил {vypito} мл. Возвращайся скорее! 👋")
        break

    # Проверка на отрицательное число
    if porciya < 0:
        print("⚠️ Число должно быть положительным!\n")
        continue

    # Добавляем к общему счёту
    vypito = vypito + porciya
    print(f"✅ Отлично! +{porciya} мл\n")

# Если норма выполнена
if vypito >= norma:
    print("=" * 40)
    print(f"🎉 МОЛОДЕЦ, {name}!")
    print(f"Ты выпил {vypito} мл воды за день!")
    print("Твой организм скажет спасибо! 💙")
    print("=" * 40)
